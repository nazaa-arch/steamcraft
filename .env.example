# ==============================================================
# STEAM-Craft — Environment Variables Configuration
# ==============================================================
# Port server (default: 3000)
PORT=3000

# Directory tempat penyimpanan database SQLite (default: ./steamcraft.db)
# DATA_DIR=./data

# ==============================================================
# Konfigurasi SMTP Pengiriman Email (Opsional)
# ==============================================================
# Jika variabel di bawah ini TIDAK diisi, sistem berjalan dalam
# Smart Dev Mode (kode OTP tetap ditampilkan di notifikasi layar).
#
# Untuk mengirim email asli (misal menggunakan Gmail gratis):
# 1. Buka Akun Google > Keamanan > Verifikasi 2 Langkah > Sandi Aplikasi (App Password).
# 2. Buat sandi aplikasi baru bernama "STEAM-Craft".
# 3. Salin 16 huruf sandi aplikasi tersebut ke SMTP_PASS di bawah.
# ==============================================================

SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=email.kampus.anda@gmail.com
SMTP_PASS=xxxx xxxx xxxx xxxx
SMTP_FROM=STEAM-Craft Verification <no-reply@steamcraft.ac.id>
